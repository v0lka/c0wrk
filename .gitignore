# =============================================================================
# Node.js / Frontend
# =============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Lockfiles: the npm lockfile for frontend/ IS committed (reproducible CI
# installs via `npm ci`); alternative registries' lockfiles stay untracked.
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
/build/bin/
.next/
.nuxt/
.output/

# Wails-generated frontend glue, regenerated by every `wails build`/`wails dev`.
# Only the ROOT `wailsjs/runtime` shim (pure Wails boilerplate) is untracked: its
# content never changes while Wails rewrites it with mode 0644, producing a
# mode-only diff on every build. The sibling `frontend/wailsjs/go/` bindings ARE
# tracked on purpose -- they are the Go<->TS contract and their content only
# changes when the `desktop.App` API changes.
/frontend/wailsjs/runtime/

# Vite
.vite/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Python bytecode (e.g. from the bundled study-paper skill scripts)
__pycache__/
*.py[cod]

# Environment variables
.env.local
.env.*.local

