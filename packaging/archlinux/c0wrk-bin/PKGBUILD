# Maintainer: c0wrk Team <https://github.com/v0lka/c0wrk>

pkgname=c0wrk-bin
pkgver=0.7.3
pkgrel=1
pkgdesc='Agentic desktop workspace for research, coding and writing (prebuilt release binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/v0lka/c0wrk'
license=('MIT')
# Every library the binary links directly (objdump -p ... NEEDED), listed
# explicitly rather than relying on gtk3/webkit2gtk-4.1 to pull them in.
depends=('gtk3' 'webkit2gtk-4.1' 'glib2' 'gdk-pixbuf2' 'libsoup3')
optdepends=(
	'ripgrep: faster content search (otherwise downloaded into ~/.c0wrk on demand)'
	'git: repository-aware project features'
	'wl-clipboard: clipboard integration on Wayland'
	'xclip: clipboard integration on X11'
)
provides=("c0wrk=$pkgver")
conflicts=('c0wrk' 'c0wrk-git')
install='c0wrk.install'
# The release archive ships a Go binary and a prebuilt libonnxruntime.so.
# Stripping either gains little and risks breaking them, and there are no
# sources to attach a debug package to.
options=('!strip' '!debug')

_relurl="$url/releases/download/v$pkgver"
_rawurl="https://raw.githubusercontent.com/v0lka/c0wrk/v$pkgver"

# The upstream tarball is flat (its members are ./c0wrk-desktop, ./models/, ...)
# so it extracts straight into $srcdir. The download is renamed to carry the
# package name and version, keeping distinct releases apart in makepkg's cache.
source=(
	"$pkgname-$pkgver-LICENSE::$_rawurl/LICENSE"
	"$pkgname-$pkgver-appicon.png::$_rawurl/build/appicon.png"
	'c0wrk-desktop.desktop'
)
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$_relurl/c0wrk-desktop-linux-amd64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$_relurl/c0wrk-desktop-linux-arm64.tar.gz")

sha256sums=('26a0f4863f365c987a6762b0a48e987136543118989b2f00f2d57c70a45ffd15'
            '2c376e0af62ec11c97a1a931b7c7c3a93eaa3193a362876cc33b09b3ebbe0ee8'
            '38debab7da7def84d2e05efec82f39109930b0e7e94279eb660e4b838cd4350e')
# Digests as published in the release's SHA256SUMS asset:
#   curl -sL https://github.com/v0lka/c0wrk/releases/download/v0.7.3/SHA256SUMS
sha256sums_x86_64=('7e76639238e760e9007ab95f0d5d2eca8466bdd0c43d9a99a59d3a4c50c886ae')
sha256sums_aarch64=('89c80a6413feaaf995ef3d9998f3bd097bae28b79ea674e5c2a6b0e7b0718e33')

package() {
	# Everything the app needs at runtime must sit in ONE directory: the binary
	# resolves libonnxruntime.so and models/ relative to its own executable
	# (desktop/startup.go resolveONNXLibPath / resolveModelPath). Splitting the
	# tree across /usr/lib and /usr/share would break both lookups.
	install -Dm755 "$srcdir/c0wrk-desktop" "$pkgdir/opt/c0wrk/c0wrk-desktop"
	install -Dm755 "$srcdir/libonnxruntime.so" "$pkgdir/opt/c0wrk/libonnxruntime.so"
	install -Dm644 "$srcdir/models/jina-v2-small.onnx" \
		"$pkgdir/opt/c0wrk/models/jina-v2-small.onnx"
	install -Dm644 "$srcdir/models/jina-v2-small-tokenizer.json" \
		"$pkgdir/opt/c0wrk/models/jina-v2-small-tokenizer.json"

	# Symlinks, not wrapper scripts: on Linux os.Executable() reads
	# /proc/self/exe, which is already resolved, so the executable directory is
	# /opt/c0wrk no matter which name was invoked.
	install -dm755 "$pkgdir/usr/bin"
	ln -s /opt/c0wrk/c0wrk-desktop "$pkgdir/usr/bin/c0wrk-desktop"
	ln -s /opt/c0wrk/c0wrk-desktop "$pkgdir/usr/bin/c0wrk"

	install -Dm644 "$srcdir/c0wrk-desktop.desktop" \
		"$pkgdir/usr/share/applications/c0wrk-desktop.desktop"
	install -Dm644 "$srcdir/$pkgname-$pkgver-appicon.png" \
		"$pkgdir/usr/share/icons/hicolor/512x512/apps/c0wrk-desktop.png"
	install -Dm644 "$srcdir/$pkgname-$pkgver-LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
